@page "/task/{TaskId:guid}"
@using WorkflowBase
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

@if (task is null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">در حال بارگذاری وظیفه...</p>
    </div>
}
else
{
    <h3 class="mb-4">وظیفه #@task.Id</h3>

    @if (task.ContextDisplayFields.Any())
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header bg-gradient-primary text-white">
                <h5 class="mb-0">اطلاعات کلیدی درخواست</h5>
            </div>
            <div class="card-body">
                <dl class="row g-3">
                    @foreach (var field in task.ContextDisplayFields.OrderBy(x => x.Order))
                    {
                        var valueStr = field.Value?.ToString() ?? "—";
                        if (string.IsNullOrWhiteSpace(valueStr)) continue;
                        <dt class="col-sm-4 text-muted fw-medium">@field.Label</dt>
                        <dd class="col-sm-7 @(field.CssClass ?? "")">@valueStr</dd>
                    }
                </dl>
            </div>
        </div>
    }

    @if (task.Inputs.Any())
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header bg-light">
                <h5 class="mb-0">تکمیل وظیفه</h5>
            </div>
            <div class="card-body">
                <form id="taskForm" onsubmit="return false;">
                    @foreach (var input in task.Inputs)
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                @input.Lable
                                @if (input.IsRequired)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @switch (input.Type)
                            {
                                case InputType.Text:
                                    <input type="text"
                                           id="@($"input-{input.Name}")"
                                           name="@input.Name"
                                           class="form-control" />
                                    break;

                                case InputType.Number:
                                    <input type="number"
                                           id="@($"input-{input.Name}")"
                                           name="@input.Name"
                                           class="form-control" />
                                    break;

                                case InputType.Dropdown:
                                    <select id="@($"input-{input.Name}")"
                                            name="@input.Name"
                                            class="form-select">
                                        <option value="">انتخاب کنید</option>
                                        @foreach (var opt in input.Options)
                                        {
                                            <option value="@opt.Key">@opt.Value</option>
                                        }
                                    </select>
                                    break;

                                case InputType.MultiSelect:
                                    <select multiple
                                            id="@($"input-{input.Name}")"
                                            name="@input.Name"
                                            class="form-select"
                                            size="5">
                                        @foreach (var opt in input.Options)
                                        {
                                            <option value="@opt.Key">@opt.Value</option>
                                        }
                                    </select>
                                    break;

                                case InputType.FileUpload:
                                    <input type="file"
                                           id="@($"input-{input.Name}")"
                                           name="@input.Name"
                                           class="form-control" />
                                    break;

                                default:
                                    <div class="alert alert-warning py-2">
                                        نوع ورودی پشتیبانی نمی‌شود: @input.Type
                                    </div>
                                    break;
                            }
                        </div>
                    }

                    <div class="d-flex gap-3 justify-content-end mt-4 pt-3 border-top">
                        <button type="button"
                                class="btn btn-success px-4 py-2"
                                onclick="window.submitTask('@TaskId')">
                            ارسال و تکمیل وظیفه
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary px-4 py-2"
                                onclick="window.location.href='/tasks'">
                            انصراف
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid TaskId { get; set; }
    private WorkflowTask? task;
    private Dictionary<string, string> formData = new();

    protected override async Task OnInitializedAsync()
    {
        task = await Http.GetFromJsonAsync<WorkflowTask>($"api/tasks/{TaskId}");
    }
}

<!-- اسکریپت باید داخل همین کامپوننت یا در index.html/_Host.cshtml لود شود -->
<script>
    window.submitTask = async function (taskId) {

        const form = document.getElementById("taskForm");
        if (!form) {
            alert("فرم پیدا نشد");
            return;
        }

        const elements = form.querySelectorAll("input, select, textarea");
        const formDataObj = {};

        elements.forEach(el => {
            if (!el.name) return;

            // فایل (فعلاً فقط نام فایل)
            if (el.type === "file") {
                if (el.files.length > 0) {
                    formDataObj[el.name] = el.files[0].name;
                }
                return;
            }

            // مولتی سلکت
            if (el.multiple) {
                const values = Array.from(el.selectedOptions).map(o => o.value);
                formDataObj[el.name] = values;
                return;
            }

            // مقدار عادی
            formDataObj[el.name] = el.value ?? "";
        });

        const payload = {
            formData: formDataObj
        };

        try {
            const response = await fetch(`/api/tasks/${taskId}/complete`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                window.location.href = "/tasks";
            } else {
                const text = await response.text();
                console.error(text);
                alert("خطا در ثبت وظیفه");
            }
        } catch (err) {
            console.error(err);
            alert("خطا در ارتباط با سرور");
        }
    };
</script>
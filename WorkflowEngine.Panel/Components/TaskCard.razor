@using WorkflowBase
<div class="card h-100 shadow-sm hover-shadow transition-all"
     style="cursor: pointer;"
     @onclick="OnClick">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h6 class="card-title mb-0 text-truncate" style="max-width: 70%;">
                وظیفه #@Task.Title
            </h6>
            <TaskStatusBadge Status="Task.Status" />
        </div>

        <div class="small text-muted mb-2">
            <i class="bi bi-person me-1"></i> @Task.Role
            @if (!string.IsNullOrEmpty(Task.Assignee))
            {
                <span> → @Task.Assignee ??@Task.Role </span>
            }
        </div>

        <div class="small text-muted mb-3">
            <i class="bi bi-calendar-event me-1"></i>
            ایجاد: @Task.CreatedOn.ToString("yyyy/MM/dd HH:mm")
        </div>

        @if (Task.Inputs.Any())
        {
            <div class="small text-primary mb-2">
                <i class="bi bi-ui-checks-grid me-1"></i>
                @Task.Inputs.Count مورد ورودی نیاز است
            </div>
        }

        <div class="mt-auto">
            <button class="btn btn-outline-primary btn-sm w-100">
              
                <a href="/task/@Task.Id" class="btn btn-outline-primary">  مشاهده و اقدام</a>
                <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public WorkflowTask Task { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }
}
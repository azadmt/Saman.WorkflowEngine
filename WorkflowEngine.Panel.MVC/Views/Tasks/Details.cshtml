@model WorkflowTask
@using WorkflowBase


@{
    ViewData["Title"] = "جزئیات وظیفه";
}

<div class="task-details-container">

    <!-- Header -->
    <div class="details-header">
        <div>
            <h3 class="details-title">@Model.Title</h3>
            <span class="status-badge @(Model.Status == WorkflowTaskStatus.Completed ? "done" : "open")">
                @(Model.Status == WorkflowTaskStatus.Open ? "وظیفه باز" : "تکمیل شده")
            </span>
        </div>

        <a href="/Tasks" class="btn btn-light border">
            بازگشت به لیست
        </a>
    </div>

    <!-- Context Info -->
    @if (Model.ContextDisplayFields?.Any() == true)
    {
        <div class="clean-card mb-4">
            <div class="card-section-title">
                اطلاعات درخواست
            </div>

            <div class="info-grid">
                @foreach (var field in Model.ContextDisplayFields.OrderBy(x => x.Order))
                {
                    if (field.Value == null)
                        continue;

                    <div class="display-section mb-4">

                        <div class="display-label">
                            @field.Label
                        </div>

                        @* اگر GridColumns دارد و Value لیست است *@
                        @if (field.GridColumns != null &&
                                        field.Value is System.Collections.IEnumerable enumerable &&
                                        !(field.Value is string))
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped custom-table">
                                    <thead>
                                        <tr>
                                            @foreach (var col in field.GridColumns)
                                            {
                                                <th>@col.Header</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in enumerable)
                                        {
                                            <tr>
                                                @foreach (var col in field.GridColumns)
                                                {
                                                    var prop = item.GetType().GetProperty(col.Field);
                                                    var val = prop?.GetValue(item);

                                                    if (col.Format != null && val is DateTime dt)
                                                    {
                                                        <td>@dt.ToString(col.Format)</td>
                                                    }
                                                    else if (val is bool b)
                                                    {
                                                        <td>
                                                            <span class="badge @(b ? "bg-success" : "bg-secondary")">
                                                                @(b ? "بله" : "خیر")
                                                            </span>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>@val</td>
                                                    }
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="display-value">
                                @field.Value
                            </div>
                        }

                    </div>
                }
            </div>
        </div>
    }

    <!-- Form Section -->
    @if (Model.Inputs?.Any() == true && Model.Status == WorkflowTaskStatus.Open)
    {
        <div class="clean-card">
            <div class="card-section-title">
                تکمیل وظیفه
            </div>

            <form id="taskForm" class="modern-form">
                <input type="hidden" id="taskId" value="@Model.Id" />

                <div class="form-grid">
                    @foreach (var input in Model.Inputs)
                    {
                        <div class="form-field">
                            <label class="field-label">
                                @input.Lable
                                @if (input.IsRequired)
                                {
                                    <span class="required-badge">اجباری</span>
                                }
                            </label>

                            @switch (input.Type)
                            {
                                case WorkflowBase.InputType.Text:
                                    <input type="text" name="@input.Name" class="form-control modern-input" />
                                    break;

                                case WorkflowBase.InputType.Number:
                                    <input type="number" name="@input.Name" class="form-control modern-input" />
                                    break;

                                case WorkflowBase.InputType.Dropdown:
                                    <select name="@input.Name" class="form-select modern-input">
                                        <option value="">انتخاب کنید</option>
                                        @foreach (var opt in input.Options)
                                        {
                                            <option value="@opt.Key">@opt.Value</option>
                                        }
                                    </select>
                                    break;

                                case WorkflowBase.InputType.MultiSelect:
                                    <select multiple name="@input.Name" class="form-select modern-input multi-select">
                                        @foreach (var opt in input.Options)
                                        {
                                            <option value="@opt.Key">@opt.Value</option>
                                        }
                                    </select>
                                    break;

                                case WorkflowBase.InputType.FileUpload:
                                    <input type="file" name="@input.Name" class="form-control modern-input" />
                                    break;
                            }
                        </div>
                    }
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-success btn-lg px-5" onclick="submitTask()">
                        ثبت و تکمیل وظیفه
                    </button>
                </div>
            </form>
        </div>
    }
</div>

<script src="~/js/task.js"></script>
